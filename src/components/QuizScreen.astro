---
---

<section id="quiz-screen" class="quiz-screen">
  <div class="progress-bar">
    <div class="progress-fill" id="progress-fill"></div>
  </div>
  <div class="question-meta">
    <div class="q-number" id="q-number">Q.01 / 10</div>
    <div class="q-topic" id="q-topic">PROMPT INJECTION</div>
  </div>
  <h2 class="question-text" id="question-text"></h2>
  <div class="scenario-box" id="scenario-box" style="display:none;"></div>
  <div class="options" id="options"></div>

  <div class="explanation" id="explanation">
    <div class="explanation-header">
      <span class="verdict" id="verdict"></span>
      <span id="verdict-meta"></span>
    </div>
    <div class="explanation-body">
      <h3 id="explanation-title"></h3>
      <div id="explanation-text"></div>
      <div class="takeaway" id="takeaway" data-lang="ja"></div>
      <div class="sources" id="sources" style="display:none;">
        <div class="sources-label" data-i18n="sourcesLabel">// Sources</div>
        <ul id="sources-list"></ul>
      </div>
    </div>
  </div>

  <button class="next-btn" id="next-btn" type="button"></button>
</section>
