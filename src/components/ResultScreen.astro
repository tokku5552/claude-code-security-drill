---

---

<section id="result-screen" class="result-screen">
  <div class="result-hero">
    <div class="label" data-i18n="resultLabel">// DRILL COMPLETE</div>
    <div class="score">
      <span id="final-score">0</span><span class="out-of">/10</span>
    </div>
    <div class="rank" data-i18n="rankHeading">RANK</div>
    <div class="rank-name" id="rank-name">—</div>
  </div>

  <div class="result-msg" id="result-msg"></div>

  <div class="breakdown">
    <div class="breakdown-title" data-i18n="breakdownTitle">
      // Question Breakdown
    </div>
    <div class="breakdown-list" id="breakdown-list"></div>
  </div>

  <div class="share-section">
    <div class="share-label" data-i18n="shareLabel">// この結果をシェア</div>
    <div class="share-btns">
      <a
        id="share-x"
        class="share-btn"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24"
          ><path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
          ></path></svg
        >
        <span data-i18n="shareXBtn">Xでシェア</span>
      </a>
      <button
        id="share-copy"
        class="share-btn share-btn-secondary"
        type="button"
      >
        <svg viewBox="0 0 24 24"
          ><path
            d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
          ></path></svg
        >
        <span data-i18n="shareCopyBtn">リンクをコピー</span>
      </button>
    </div>
    <div id="copied-toast" class="copied-toast" data-i18n="copiedToast">
      ✓ Copied to clipboard
    </div>
  </div>

  <button
    id="restart-btn"
    class="restart-btn"
    type="button"
    data-i18n="restartBtn"
  >
    もう一度挑戦する ↻
  </button>
</section>
